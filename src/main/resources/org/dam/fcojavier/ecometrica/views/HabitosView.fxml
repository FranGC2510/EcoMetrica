<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.dam.fcojavier.ecometrica.controllers.HabitosController"
            styleClass="content-area">

    <top>
        <VBox spacing="5.0">
            <Label text="Mis Hábitos" styleClass="titulo-app">
                <font><Font name="System Bold" size="24.0"/></font>
            </Label>
            <Label text="Configura tus actividades recurrentes" styleClass="subtitulo"/>
            <padding><Insets bottom="20"/></padding>
        </VBox>
    </top>

    <left>
        <VBox spacing="15.0" styleClass="login-container" maxWidth="300.0">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Editar Hábito" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>

            <VBox spacing="5">
                <Label text="Categoría"/>
                <ComboBox fx:id="cbCategoria" promptText="Selecciona..." maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Actividad"/>
                <ComboBox fx:id="cbActividad" promptText="Primero categoría..." disable="true" maxWidth="Infinity"/>
            </VBox>

            <HBox spacing="10">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Frecuencia"/>
                    <TextField fx:id="txtFrecuencia" promptText="Ej: 3"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Tipo"/>
                    <ComboBox fx:id="cbTipo" promptText="Semanal" maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <VBox spacing="5">
                <Label text="Última vez realizado"/>
                <DatePicker fx:id="dpUltimaFecha" maxWidth="Infinity"/>
            </VBox>

            <Label fx:id="lblMensaje" wrapText="true"/>

            <Button text="GUARDAR CONFIGURACIÓN" onAction="#onGuardarClick" styleClass="btn-primary" maxWidth="Infinity"/>
            <Button text="Limpiar / Nuevo" onAction="#onLimpiarClick" styleClass="btn-flat" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox>
            <padding><Insets left="20"/></padding>
            <TableView fx:id="tablaHabitos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="100"/>
                    <TableColumn fx:id="colActividad" text="Actividad" prefWidth="150"/>
                    <TableColumn fx:id="colFrecuencia" text="Frecuencia" prefWidth="80"/>
                    <TableColumn fx:id="colTipo" text="Periodo" prefWidth="100"/>
                    <TableColumn fx:id="colFecha" text="Última Fecha" prefWidth="100"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            <Label text="* Selecciona una fila para editarla" style="-fx-font-style: italic; -fx-text-fill: gray;">
                <VBox.margin><Insets top="5"/></VBox.margin>
            </Label>
        </VBox>
    </center>

</BorderPane>
