<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.dam.fcojavier.ecometrica.controllers.EstadisticasController"
            styleClass="content-area">

    <top>
        <VBox spacing="10.0">
            <padding><Insets bottom="10"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <Label text="Análisis de Impacto" styleClass="titulo-app">
                    <font><Font name="System Bold" size="24.0"/></font>
                </Label>
                <Label maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="form-panel" style="-fx-padding: 10;">

                    <ComboBox fx:id="cbFiltroRapido" prefWidth="110" promptText="Periodo"/>

                    <Label text="|" style="-fx-text-fill: #D7CCC8;"/>

                    <Label text="Desde:" styleClass="label-campo"/>
                    <DatePicker fx:id="dpInicio" prefWidth="110"/>

                    <Label text="Hasta:" styleClass="label-campo"/>
                    <DatePicker fx:id="dpFin" prefWidth="110"/>

                    <Button text="Aplicar" onAction="#onFiltrarClick" styleClass="btn-primary" style="-fx-padding: 5 15;"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane VBox.vgrow="ALWAYS">

            <HBox fx:id="panelDatos" spacing="20.0" visible="false">
                <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                    <VBox styleClass="form-panel" VBox.vgrow="ALWAYS">
                        <Label text="Distribución por Categoría" styleClass="label-titulo-panel"/>
                        <PieChart fx:id="pieChart" legendSide="RIGHT" labelsVisible="false" VBox.vgrow="ALWAYS"/>
                    </VBox>

                    <VBox styleClass="form-panel" VBox.vgrow="ALWAYS">
                        <Label text="Datos Detallados" styleClass="label-titulo-panel"/>
                        <TableView fx:id="tablaDesglose" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colCatNombre" text="Categoría" prefWidth="120" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colCatTotal" text="Impacto (kg)" prefWidth="100" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colCatPorcentaje" text="Porcentaje" prefWidth="110" minWidth="100"
                                             style="-fx-alignment: CENTER; -fx-font-weight: bold; -fx-text-fill: -fx-color-primario;"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </VBox>

                <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                    <VBox styleClass="form-panel" VBox.vgrow="ALWAYS">
                        <Label fx:id="lblTituloGrafico" text="Evolución Temporal" styleClass="label-titulo-panel"/>
                        <BarChart fx:id="barChart" legendVisible="false" VBox.vgrow="ALWAYS" animated="false">
                            <xAxis>
                                <CategoryAxis label="Categoría" startMargin="20" endMargin="20" gapStartAndEnd="true" animated="false"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="kg CO₂" />
                            </yAxis>
                        </BarChart>
                    </VBox>
                </VBox>
            </HBox>

            <VBox fx:id="panelSinDatos" alignment="CENTER" spacing="25"
                  style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 20, 0, 0, 10); -fx-padding: 40;"
                  maxWidth="800" maxHeight="500">

                <ImageView fitHeight="180.0" fitWidth="180.0" preserveRatio="true" opacity="0.6">
                    <image>
                        <Image url="@logo.png"/>
                    </image>
                </ImageView>

                <Label text="No hay registros en este periodo"
                       style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #5D4037;"/>

                <Label text="Prueba a cambiar los filtros de fecha o registra nuevas actividades para ver tu análisis detallado aquí."
                       wrapText="true" textAlignment="CENTER" maxWidth="600"
                       style="-fx-font-size: 18px; -fx-text-fill: #8D6E63;"/>
            </VBox>

        </StackPane>
    </center>
</BorderPane>
